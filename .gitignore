# ─────────────────────────────────────────────
#  BlackVault — .gitignore
# ─────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# ── Generated datasets (re-created by generate_datasets.py) ──
backend/data/
app/data/

# ── SQLite databases ──────────────────────────
*.db
*.sqlite
*.sqlite3

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Unity (keep source, ignore generated) ─────
# OS / meta junk
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity auto-generated
Assets/AssetStoreTools*
.consulo/
ExportedObj/
.vs/
crashlytics-build.properties
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/

# ── Logs ──────────────────────────────────────
*.log
logs/

# ── Secrets / environment ─────────────────────
.env
.env.*
secrets.json
config.local.*

# ── OS junk ───────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db